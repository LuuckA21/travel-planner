# Copy to deploy/backup.env, fill in and chmod 600. Never commit backup.env.
# Values come from the Infomaniak Swiss Backup panel (S3 access); the password is yours.

# A value containing a dollar sign must be written with two ($$) in this file.
RESTIC_REPOSITORY=s3:https://<swiss-backup-s3-endpoint>/<bucket>
# Generate with: openssl rand -base64 32
# Keep a copy in a password manager: without it the backups cannot be restored.
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=change-me

# Optional dead-man pings (healthchecks.io style), no quotes: <url> on success, <url>/fail on failure.
# BACKUP_PING_URL=https://hc-ping.com/<uuid>
# BACKUP_CHECK_PING_URL=https://hc-ping.com/<uuid>
