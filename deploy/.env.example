# Copy to deploy/.env and fill in. Never commit .env.

# Interface and port the app is published on; the NPM server reaches it here (restrict with ufw).
# Change APP_PORT if 8081 is already taken on the server.
APP_BIND_IP=192.0.2.10
APP_PORT=8081
APP_BASE_URL=https://travel.example.com
APP_REGISTRATION_OPEN=false

# POSTGRES_USER/POSTGRES_PASSWORD must equal DB_USER/DB_PASSWORD. Set them before the first start:
# the database is created with them once; changing them later needs a change inside the database.
# A value containing a dollar sign must be written with two ($$) in this file.
POSTGRES_DB=travelplanner
POSTGRES_USER=travelplanner
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
DB_USER=travelplanner
DB_PASSWORD=change-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=noreply@example.com
